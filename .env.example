# Copy this file to `.env` and fill in values.
#
# Required (used by `scripts/translate_md_openai.py`)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
#
# Optional (defaults to gpt-5.2)
OPENAI_MODEL="gpt-5.2"

# Optional (defaults to uk): uk | us | international
OPENAI_ENGLISH_VARIANT="uk"
#
# Optional (advanced): override API base URL (proxy/self-hosted gateway)
# OPENAI_BASE_URL="https://api.openai.com/v1"
#
# Optional (advanced): scope billing/routing if your account uses it
# OPENAI_ORG_ID="org_..."
# OPENAI_PROJECT_ID="proj_..."
